# vAPI (jorritfolmer/vulnerable-api) for the bench. We vendor ONLY this recipe — the app code is pulled
# vanilla at build time. Upstream's own build is broken on modern machines (its unpinned deps fail: old pip
# can't build lxml, and the code targets the connexion/flask 2.x line), so this is the one thing that's ours:
# a clone + a pinned dependency set that actually runs.

# Stage 1: fetch the vanilla app (git only, no code committed to our repo).
FROM alpine/git AS src
RUN git clone --depth 1 https://github.com/jorritfolmer/vulnerable-api.git /src

# Stage 2: run it with pinned deps. lxml 4.9.4 ships prebuilt cp38 manylinux/aarch64 wheels → no source build
# (the archived-buster slim image has no libxml2 dev headers); connexion/flask/werkzeug pinned to the 2.x line
# this code targets (connexion.FlaskApp / app.add_api / connexion.request.body), matching the hosted Flask 2.2.5.
FROM python:3.8.1-slim
WORKDIR /usr/src/app
COPY --from=src /src/openapi ./openapi
COPY --from=src /src/vAPI.py .
COPY --from=src /src/vAPI.db .
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir \
      "connexion[swagger-ui]==2.14.2" \
      "flask==2.2.5" \
      "werkzeug==2.2.3" \
      "jsonschema==3.2.0" \
      "swagger-ui-bundle==0.0.9" \
      "lxml==4.9.4" \
      pyjwt cryptography
EXPOSE 8081
CMD [ "python", "./vAPI.py", "-p", "8081" ]
